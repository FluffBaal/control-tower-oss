{
  "name": "control-tower",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted web dashboard to operate a fleet of AI coding agents from one browser.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "towerctl": "./dist/cli/towerctl.js"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "doctor": "tsx src/cli/towerctl.ts doctor",
    "towerctl": "tsx src/cli/towerctl.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "start": "NODE_ENV=production node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test \"src/server/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.2.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.2"
  },
  "license": "MIT",
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
